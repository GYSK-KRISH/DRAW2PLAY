# ==============================================================================
# Draw2Play AI — Production & Deployment Environment Configuration Example
# Banana Hacks 2026 (Theme: Image AI)
# ==============================================================================

# Server Network & Runtime Configuration
PORT=3001
NODE_ENV=production

# Google Gemini API Key for Multimodal Image & Vision AI Analysis
# Optional: If omitted, the application uses deterministic local mock heuristics.
# Never expose this key in client-side VITE_* variables.
# Obtain key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Selected Gemini Model (Default / Recommended: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Permitted CORS Origins (comma-separated or '*' for public demo)
# Default is '*' for local testing and containerized demos.
CORS_ORIGIN=*

# Frontend Host URL (used for CORS headers and origin redirects)
FRONTEND_URL=http://localhost:3001

# Optional Frontend API Base URL (Only needed if hosting frontend and backend on separate domains)
# Leave blank for default unified single-service deployments.
# Example: VITE_API_BASE_URL=https://api.draw2play.app
VITE_API_BASE_URL=
